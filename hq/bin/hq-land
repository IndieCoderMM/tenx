#!/usr/bin/env bash
# Remove what a merged hq feature left behind, HQ itself last.
#
#   hq-land <slug>
#
# Run from HQ's pane in the feature worktree. Refuses unless the branch's PR is
# merged at exactly this HEAD and the worktree is clean. Closes the builder,
# reviewer, and scout panes; removes the scout worktree and branch; marks
# plan.md landed; then removes the feature worktree and branch and closes HQ's
# Herdr workspace, which ends this session. plan.md stays for retro.
set -euo pipefail

die() { echo "hq-land: $*" >&2; exit 1; }
json() { python3 -I -c "import json,sys
d=json.load(sys.stdin)
for k in sys.argv[1].split('.'): d=d.get(k,{}) if isinstance(d,dict) else {}
print(d if d!={} else '')" "$1"; }

[ "${HERDR_ENV:-}" = 1 ] || die "not inside Herdr"
slug="${1:?usage: hq-land <slug>}"

here="$(git rev-parse --show-toplevel)"
main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
repo="$(basename "$main")"
dir="$HOME/.tenx/flow/$repo/$slug"
branch="$(git branch --show-current)"
[ "$here" != "$main" ] || die "HQ is in the main checkout — run from the feature worktree"
[ -z "$(git status --porcelain)" ] || die "uncommitted changes in $here"

pr="$(gh pr view "$branch" --json state,headRefOid,url 2>/dev/null)" || die "no PR for $branch"
url="$(json url <<<"$pr")"
[ "$(json state <<<"$pr")" = MERGED ] || die "PR not merged: $url"
[ "$(json headRefOid <<<"$pr")" = "$(git rev-parse HEAD)" ] ||
  die "local $branch differs from the merged PR head: $url"

for kind in builder reviewer scout; do
  name="$kind-$slug"; name="${name:0:32}"
  pane="$(herdr agent get "$name" 2>/dev/null | json result.agent.pane_id 2>/dev/null || true)"
  [ -n "$pane" ] && herdr pane close "$pane" >/dev/null && echo "closed   $name ($pane)"
done

scout="$(dirname "$main")/$repo-worktrees/scout-$slug"
if [ -d "$scout" ]; then
  ws="$(herdr workspace list | python3 -I -c "import json,sys
for w in json.load(sys.stdin)['result']['workspaces']:
    if (w.get('worktree') or {}).get('checkout_path') == sys.argv[1]: print(w['workspace_id'])" "$scout")"
  if [ -n "$ws" ]; then herdr worktree remove --workspace "$ws" >/dev/null
  else git -C "$main" worktree remove "$scout"; fi
  echo "removed  $scout"
fi
git -C "$main" branch -D "$slug-scout" >/dev/null 2>&1 && echo "deleted  branch $slug-scout"

if [ -f "$dir/plan.md" ]; then
  python3 -I - "$dir/plan.md" "landed · $(date +%F) · $url · —" <<'EOF'
import re, sys
p, line = sys.argv[1], sys.argv[2]
t = open(p).read()
t = re.sub(r"(## Resume\s*\n\s*\n?).*", lambda m: m.group(1) + line + "\n", t, count=1, flags=re.S)
open(p, "w").write(t)
EOF
  echo "marked   $dir/plan.md landed"
fi

echo "removing $here, branch $branch, and this workspace — HQ ends here"
cd "$main"
git worktree remove "$here"
git branch -D "$branch" >/dev/null
herdr workspace close "$HERDR_WORKSPACE_ID" >/dev/null
