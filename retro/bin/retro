#!/usr/bin/env python3
"""Weekly workflow retro: capture friction, measure the week, render the dashboard.

Usage:
    retro friction <text>                 append one row to ~/.tenx/retro/friction.tsv
    retro stats [--days 7] [--end DATE]   write ~/.tenx/retro/weeks/<week>.json, print a digest
    retro render [--week YYYY-Www]        write ~/.tenx/retro/dashboard.html from every week on disk

Reads only local files: ~/.claude/history.jsonl, ~/.claude/projects/*/*.jsonl,
~/.tenx/flow/*/*/{logs.tsv,contract.md}, and `git worktree list` for repos
worked in during the window.
"""

import argparse
import collections
import datetime as dt
import glob
import html
import json
import os
import pathlib
import random
import re
import subprocess
import sys

HOME = pathlib.Path.home()
RETRO = HOME / ".tenx" / "retro"
WEEKS = RETRO / "weeks"
FRICTION = RETRO / "friction.tsv"
CLAUDE = HOME / ".claude"
PLANS = HOME / ".tenx" / "flow"
MAX_FRICTION = 300
SAMPLES = 8

APPROVAL = re.compile(
    r"^(go|go ahead|go on|ok|okay|yes|yep|y|continue|proceed|approved?|lgtm|do it|sure|"
    r"commit|commit it|commit this|commit changes|commit and push|push|retry|try again|\d{1,2})$"
)
CORRECTION = re.compile(
    r"^(no\b|nope|don'?t|stop|wrong|revert|undo|not what|that'?s not|i said|why did|why are you|"
    r"why is it|you didn'?t|it'?s still|still (not|broken|failing|wrong))",
    re.I,
)

# Lower is better for these; the rest are activity counts with no direction.
LOWER_IS_BETTER = {
    "approvals_per_100", "corrections", "interrupts", "denials", "tool_errors",
    "usage_checks", "reversal_rate", "stale_tasks", "stale_worktrees", "compactions",
}
LABELS = {
    "approvals_per_100": "One-word replies / 100 prompts",
    "corrections": "Corrections",
    "interrupts": "Interrupted turns",
    "denials": "Denied tool calls",
    "tool_errors": "Tool errors",
    "usage_checks": "/usage checks",
    "compactions": "Compactions",
    "reversal_rate": "Flow reversed / done",
    "stale_tasks": "Stale flow tasks",
    "stale_worktrees": "Stale worktrees",
    "prompts": "Prompts",
    "sessions": "Sessions",
    "approvals": "One-word replies",
    "flow_done": "Flow phases done",
    "flow_reversed": "Flow reversals",
    "friction": "Friction notes",
}
SIGNALS = [
    "approvals_per_100", "corrections", "interrupts", "denials", "tool_errors",
    "usage_checks", "compactions", "reversal_rate", "stale_tasks", "stale_worktrees",
]
ACTIVITY = ["prompts", "sessions", "flow_done", "friction"]


def clean(value):
    """Flatten anything that would break the row or column structure."""
    text = "" if value is None else str(value)
    for bad in ("\t", "\n", "\r", "\v", "\f"):
        text = text.replace(bad, " ")
    return " ".join(text.split())


def now():
    return dt.datetime.now().astimezone()


def week_key(day):
    year, week, _ = day.isocalendar()
    return "%d-W%02d" % (year, week)


def parse_iso(text):
    try:
        return dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None


def git(*args, cwd=None):
    try:
        out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def main_checkout(path):
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=path)
    return str(pathlib.Path(common).parent) if common else None


# ---------------------------------------------------------------- friction

def cmd_friction(args):
    text = clean(" ".join(args.text))
    if not text:
        sys.exit("friction text is empty")
    if len(text) > MAX_FRICTION:
        text = text[: MAX_FRICTION - 1].rstrip() + "…"
    cwd = os.getcwd()
    root = main_checkout(cwd)
    repo = pathlib.Path(root).name if root else "-"
    branch = git("branch", "--show-current", cwd=cwd) or "-"
    row = (now().strftime("%Y-%m-%dT%H:%M:%S%z"), repo, branch, text)
    RETRO.mkdir(parents=True, exist_ok=True)
    fresh = not FRICTION.exists() or FRICTION.stat().st_size == 0
    with FRICTION.open("a", encoding="utf-8") as handle:
        if fresh:
            handle.write("ts\trepo\tbranch\ttext\n")
        handle.write("\t".join(row) + "\n")
    print("\t".join(row))


# ---------------------------------------------------------------- stats

def read_history(start, end):
    rows = []
    path = CLAUDE / "history.jsonl"
    if not path.exists():
        return rows
    for line in path.open(encoding="utf-8", errors="replace"):
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        ts = dt.datetime.fromtimestamp(entry.get("timestamp", 0) / 1000).astimezone()
        if start <= ts < end:
            rows.append((ts, entry.get("display", ""), entry.get("project", ""), entry.get("sessionId", "")))
    return rows


def user_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""


def read_transcripts(start, end):
    """Events from top-level session transcripts (subagent transcripts are skipped)."""
    events = []
    for path in glob.glob(str(CLAUDE / "projects" / "*" / "*.jsonl")):
        if dt.datetime.fromtimestamp(os.path.getmtime(path)).astimezone() < start:
            continue
        tools = {}
        last_text = ""
        for line in open(path, encoding="utf-8", errors="replace"):
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            ts = parse_iso(entry.get("timestamp", ""))
            message = entry.get("message") or {}
            kind = entry.get("type")
            if kind == "system" and "compact" in str(entry.get("subtype", "")):
                if ts and start <= ts < end:
                    events.append((ts, "compact", None))
                continue
            if kind == "assistant":
                for c in message.get("content") or []:
                    if not isinstance(c, dict):
                        continue
                    if c.get("type") == "tool_use":
                        tools[c.get("id")] = c.get("name", "?")
                    elif c.get("type") == "text" and c.get("text", "").strip():
                        last_text = c["text"].strip()
                continue
            if kind != "user" or not ts or not (start <= ts < end) or entry.get("isMeta"):
                continue
            content = message.get("content")
            if isinstance(content, list):
                for c in content:
                    if isinstance(c, dict) and c.get("type") == "tool_result" and c.get("is_error"):
                        text = str(c.get("content"))
                        tool = tools.get(c.get("tool_use_id"), "?")
                        denied = "doesn't want to proceed" in text or "rejected" in text
                        events.append((ts, "denied" if denied else "error", {"tool": tool, "text": text[:200]}))
            text = user_text(message).strip()
            if "[Request interrupted by user" in text:
                events.append((ts, "interrupt", {"before": last_text[-240:]}))
            elif text and not text.startswith("<") and APPROVAL.match(text.lower().rstrip(".!")):
                events.append((ts, "approval", {"reply": text[:40], "before": last_text[-240:]}))
    return events


def read_flow(start, end):
    rows, tasks = [], []
    for log in glob.glob(str(PLANS / "*" / "*" / "logs.tsv")):
        folder = pathlib.Path(log).parent
        last = None
        for line in open(log, encoding="utf-8", errors="replace"):
            cols = line.rstrip("\n").split("\t")
            if len(cols) < 4 or cols[0] == "ts":
                continue
            try:
                ts = dt.datetime.strptime(cols[0], "%Y-%m-%dT%H:%M:%S%z")
            except ValueError:
                continue
            last = max(last, ts) if last else ts
            if start <= ts < end:
                rows.append((ts, cols[1], "%s/%s" % (folder.parent.name, folder.name), cols[3]))
        stage = ""
        contract = folder / "contract.md"
        if contract.exists():
            match = re.search(r"^stage:\s*(\S+)", contract.read_text(errors="replace"), re.M)
            stage = match.group(1) if match else ""
        tasks.append({"task": "%s/%s" % (folder.parent.name, folder.name), "stage": stage,
                      "last": last.isoformat() if last else None})
    return rows, tasks


def read_friction(start, end):
    rows = []
    if not FRICTION.exists():
        return rows
    for line in FRICTION.open(encoding="utf-8", errors="replace"):
        cols = line.rstrip("\n").split("\t")
        if len(cols) < 4 or cols[0] == "ts":
            continue
        try:
            ts = dt.datetime.strptime(cols[0], "%Y-%m-%dT%H:%M:%S%z")
        except ValueError:
            continue
        if start <= ts < end:
            rows.append({"ts": cols[0], "repo": cols[1], "branch": cols[2], "text": cols[3]})
    return rows


def read_worktrees(projects, end):
    out = []
    roots = sorted({r for r in (main_checkout(p) for p in projects if os.path.isdir(p)) if r})
    for root in roots:
        listing = git("worktree", "list", "--porcelain", cwd=root) or ""
        paths = [l[9:] for l in listing.splitlines() if l.startswith("worktree ")]
        linked = [p for p in paths if p != root]
        stale = []
        for path in linked:
            last = git("log", "-1", "--format=%cI", cwd=path)
            ts = parse_iso(last) if last else None
            if ts is None or (end - ts).days > 14:
                stale.append(pathlib.Path(path).name)
        out.append({"repo": pathlib.Path(root).name, "count": len(linked), "stale": stale})
    return out


def measure(start, end, history, events, flow_rows, tasks, friction):
    prompts = [h for h in history if start <= h[0] < end]
    texts = [h[1].strip() for h in prompts]
    plain = [t for t in texts if t and not t.startswith("/")]
    approvals = sum(1 for t in plain if APPROVAL.match(t.lower().rstrip(".!")))
    evs = [e for e in events if start <= e[0] < end]
    kinds = collections.Counter(e[1] for e in evs)
    flows = [r for r in flow_rows if start <= r[0] < end]
    fk = collections.Counter(r[1] for r in flows)
    stale_tasks = [t for t in tasks if t["stage"] != "shipped" and t["last"]
                   and (end - dt.datetime.fromisoformat(t["last"])).days >= 7
                   and (end - dt.datetime.fromisoformat(t["last"])).days < 60]
    return {
        "prompts": len(prompts),
        "sessions": len({h[3] for h in prompts}),
        "approvals": approvals,
        "approvals_per_100": round(100 * approvals / len(plain), 1) if plain else 0,
        "corrections": sum(1 for t in plain if CORRECTION.match(t)),
        "interrupts": kinds["interrupt"],
        "denials": kinds["denied"],
        "tool_errors": kinds["error"],
        "usage_checks": sum(1 for t in texts if t.startswith("/usage")),
        "compactions": kinds["compact"] + sum(1 for t in texts if t.startswith("/compact")),
        "flow_done": fk["done"],
        "flow_reversed": fk["reversed"],
        "reversal_rate": round(fk["reversed"] / fk["done"], 2) if fk["done"] else float(fk["reversed"]),
        "stale_tasks": len(stale_tasks),
        "friction": sum(1 for f in friction if start <= dt.datetime.strptime(f["ts"], "%Y-%m-%dT%H:%M:%S%z") < end),
    }, stale_tasks


def cmd_stats(args):
    if args.end:
        end = dt.datetime.strptime(args.end, "%Y-%m-%d").astimezone() + dt.timedelta(days=1)
    else:
        end = now()
    start = end - dt.timedelta(days=args.days)
    prev_start = start - dt.timedelta(days=args.days)

    history = read_history(prev_start, end)
    events = read_transcripts(prev_start, end)
    flow_rows, tasks = read_flow(prev_start, end)
    friction = read_friction(prev_start, end)

    metrics, stale_tasks = measure(start, end, history, events, flow_rows, tasks, friction)
    prev, _ = measure(prev_start, start, history, events, flow_rows, tasks, friction)

    cur_hist = [h for h in history if h[0] >= start]
    # Worktrees are only knowable as they are now, so a backfilled week has none.
    worktrees = [] if args.end else read_worktrees({h[2] for h in cur_hist}, end)
    metrics["stale_worktrees"] = None if args.end else sum(len(w["stale"]) for w in worktrees)
    prev["stale_worktrees"] = None

    key = week_key(end - dt.timedelta(seconds=1))
    rng = random.Random(key)
    cur_events = [e for e in events if e[0] >= start]

    def sample(items):
        items = list(items)
        return rng.sample(items, min(SAMPLES, len(items)))

    plain = [h[1].strip() for h in cur_hist if h[1].strip() and not h[1].startswith("/")]
    commands = collections.Counter(h[1].split()[0] for h in cur_hist if h[1].startswith("/"))
    projects = collections.Counter(pathlib.Path(h[2]).name for h in cur_hist)
    errors = collections.Counter(e[2]["tool"] for e in cur_events if e[1] == "error")

    report = {
        "week": key,
        "start": start.isoformat(),
        "end": end.isoformat(),
        "generated": now().isoformat(),
        "days": args.days,
        "metrics": metrics,
        "prev": prev,
        "commands": commands.most_common(10),
        "projects": projects.most_common(6),
        "tool_errors": errors.most_common(6),
        "flow": {
            "reversed": [{"task": r[2], "summary": r[3]} for r in flow_rows if r[0] >= start and r[1] == "reversed"],
            "stale_tasks": stale_tasks,
        },
        "worktrees": worktrees,
        "friction": [f for f in friction if dt.datetime.strptime(f["ts"], "%Y-%m-%dT%H:%M:%S%z") >= start],
        "samples": {
            "approvals": sample(e[2] for e in cur_events if e[1] == "approval"),
            "interrupts": sample(e[2] for e in cur_events if e[1] == "interrupt" and e[2]["before"]),
            "corrections": sample(t[:300] for t in plain if CORRECTION.match(t)),
            "errors": sample(e[2] for e in cur_events if e[1] == "error"),
        },
    }
    WEEKS.mkdir(parents=True, exist_ok=True)
    path = WEEKS / ("%s.json" % key)
    path.write_text(json.dumps(report, indent=1, ensure_ascii=False))

    print("week %s  (%s → %s)  %s" % (key, start.date(), (end - dt.timedelta(seconds=1)).date(), path))
    for name in SIGNALS + ACTIVITY:
        before = prev.get(name)
        delta = "" if before is None else "  (prev %s)" % before
        print("  %-20s %s%s" % (name, metrics[name], delta))


# ---------------------------------------------------------------- render

CSS = """
:root{--bg:#f4f3ef;--surface:#fcfcfb;--ink:#0b0b0b;--ink-2:#52514e;--ink-3:#8a8984;--line:#e4e2dc;
