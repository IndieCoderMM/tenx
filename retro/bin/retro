"""


def esc(value):
    return html.escape("" if value is None else str(value))


def fmt(value):
    if value is None:
        return "–"
    if isinstance(value, float) and not value.is_integer():
        return "%.2g" % value if value < 1 else "%.1f" % value
    return "{:,}".format(int(value))


def delta_html(name, cur, prev):
    if prev is None:
        return '<span class="delta flat">no prior week</span>'
    diff = cur - prev
    if diff == 0:
        return '<span class="delta flat">= same as prior week</span>'
    arrow = "▲" if diff > 0 else "▼"
    tone = "flat"
    if name in LOWER_IS_BETTER:
        tone = "bad" if diff > 0 else "good"
    return '<span class="delta %s">%s %s%s vs prior week</span>' % (tone, arrow, "+" if diff > 0 else "", fmt(diff))


def spark(name, weeks):
    points = [(w["week"], w["metrics"].get(name)) for w in weeks if w["metrics"].get(name) is not None]
    if len(points) < 2:
        return ""
    width, height = 160, 34
    values = [v for _, v in points]
    lo, hi = min(values), max(values)
    span = (hi - lo) or 1
    step = width / (len(points) - 1)
    xy = [(i * step, height - 3 - (v - lo) / span * (height - 6)) for i, (_, v) in enumerate(points)]
    line = " ".join("%.1f,%.1f" % p for p in xy)
    hits = "".join(
        '<circle cx="%.1f" cy="%.1f" r="9" fill="transparent"><title>%s: %s</title></circle>' % (x, y, esc(k), fmt(v))
        for (x, y), (k, v) in zip(xy, points))
    lx, ly = xy[-1]
    return ('<svg class="spark" width="%d" height="%d" viewBox="0 0 %d %d" role="img" aria-label="%s by week">'
            '<polyline points="%s" fill="none" stroke="var(--spark)" stroke-width="2" stroke-linejoin="round"/>'
            '<circle cx="%.1f" cy="%.1f" r="4" fill="var(--accent)" stroke="var(--surface)" stroke-width="2"/>%s</svg>'
            % (width, height, width, height, esc(LABELS[name]), line, lx, ly, hits))


def tiles(names, week, weeks):
    out = []
    for name in names:
        cur = week["metrics"].get(name)
        out.append('<div class="card tile"><div class="label">%s</div><div class="value">%s</div>%s%s</div>'
                   % (esc(LABELS[name]), fmt(cur), delta_html(name, cur, week["prev"].get(name)), spark(name, weeks)))
    return '<div class="grid">%s</div>' % "".join(out)


def bars(title, pairs):
    if not pairs:
        return '<div class="card"><h3>%s</h3><p class="empty">none</p></div>' % esc(title)
    top = max(n for _, n in pairs) or 1
    rows = "".join('<div class="bar"><span class="k" title="%s">%s</span><span class="track"><div class="fill" '
                   'style="width:%.0f%%"></div></span><span class="n">%s</span></div>'
                   % (esc(k), esc(k), 100 * n / top, fmt(n)) for k, n in pairs)
    return '<div class="card"><h3>%s</h3>%s</div>' % (esc(title), rows)


def review_html(review, prev_review):
    parts = []
    experiments = (review or {}).get("experiments") or []
    if experiments:
        rows = "".join("<tr><td>%s</td><td>%s</td><td>%s</td></tr>"
                       % (esc(e.get("change")), esc(LABELS.get(e.get("metric"), e.get("metric"))),
                          esc(e.get("target", "down"))) for e in experiments)
        parts.append('<div class="card"><h3>Running this week</h3><table><tr><th>Change</th><th>Watch</th>'
                     '<th>Want</th></tr>%s</table></div>' % rows)
    verdicts = (review or {}).get("verdicts") or []
    if verdicts:
        rows = "".join('<tr><td>%s</td><td>%s → %s</td><td><span class="tag %s">%s</span> %s</td></tr>'
                       % (esc(v.get("experiment")), fmt(v.get("before")), fmt(v.get("after")),
                          esc(v.get("verdict")), esc(v.get("verdict")), esc(v.get("note")))
                       for v in verdicts)
        parts.append('<div class="card"><h3>Last week\'s experiments</h3><table><tr><th>Change</th>'
                     '<th>Metric</th><th>Verdict</th></tr>%s</table></div>' % rows)
    if not parts:
        return '<p class="empty">No review recorded for this week yet. Run /retro.</p>'
    return '<div class="cols">%s</div>' % "".join(parts)


def findings_html(review):
    findings = (review or {}).get("findings") or []
    if not findings:
        return '<p class="empty">No findings recorded.</p>'
    items = "".join('<li><b>%s</b> %s<br><span class="muted">Evidence:</span> %s<br>'
                    '<span class="muted">Change:</span> %s %s</li>'
                    % (esc(f.get("title")), '<span class="tag">picked</span>' if f.get("picked") else "",
                       esc(f.get("evidence")), esc(f.get("change")),
                       '<code>%s</code>' % esc(f["file"]) if f.get("file") else "") for f in findings)
    return '<div class="card"><ol>%s</ol></div>' % items


def evidence_html(week):
    s = week.get("samples", {})
    blocks = []
    if s.get("approvals"):
        q = "".join("<blockquote>…%s<br><b>→ %s</b></blockquote>" % (esc(a["before"]), esc(a["reply"]))
                    for a in s["approvals"])
        blocks.append("<details><summary>What Claude said before a one-word reply (%d)</summary>%s</details>"
                      % (len(s["approvals"]), q))
    if s.get("interrupts"):
        q = "".join("<blockquote>…%s</blockquote>" % esc(a["before"]) for a in s["interrupts"])
        blocks.append("<details><summary>Last thing Claude said before you interrupted (%d)</summary>%s</details>"
                      % (len(s["interrupts"]), q))
    if s.get("corrections"):
        q = "".join("<blockquote>%s</blockquote>" % esc(t) for t in s["corrections"])
        blocks.append("<details><summary>Your corrections (%d)</summary>%s</details>" % (len(s["corrections"]), q))
    if s.get("errors"):
        q = "".join("<blockquote><b>%s</b> %s</blockquote>" % (esc(e["tool"]), esc(e["text"])) for e in s["errors"])
        blocks.append("<details><summary>Tool errors (%d)</summary>%s</details>" % (len(s["errors"]), q))
    return '<div class="card">%s</div>' % ("".join(blocks) or '<p class="empty">No samples.</p>')


def friction_html(week):
    rows = week.get("friction") or []
    if not rows:
        return '<p class="empty">No friction captured this week. Use /friction when something gets in the way.</p>'
    body = "".join("<tr><td>%s</td><td>%s<br><span class='muted'>%s</span></td><td>%s</td></tr>"
                   % (esc(r["ts"][:10]), esc(r["repo"]), esc(r["branch"]), esc(r["text"])) for r in rows)
    return '<div class="card"><table><tr><th>Date</th><th>Where</th><th>Note</th></tr>%s</table></div>' % body


def flow_html(week):
    f = week.get("flow", {})
    rev = "".join("<li><b>%s</b> %s</li>" % (esc(r["task"]), esc(r["summary"])) for r in f.get("reversed", []))
    stale = "".join("<li>%s <span class='muted'>%s · last log %s</span></li>"
                    % (esc(t["task"]), esc(t["stage"] or "no stage"), esc((t["last"] or "")[:10]))
                    for t in f.get("stale_tasks", []))
    wts = "".join("<li>%s: %d worktrees%s</li>" % (
        esc(w["repo"]), w["count"], (", stale: " + esc(", ".join(w["stale"]))) if w["stale"] else "")
        for w in week.get("worktrees", []))
    return ('<div class="cols"><div class="card"><h3>Reversed decisions</h3>%s</div>'
            '<div class="card"><h3>Stale flow tasks</h3>%s</div><div class="card"><h3>Worktrees</h3>%s</div></div>'
            % ("<ul>%s</ul>" % rev if rev else '<p class="empty">none</p>',
               "<ul>%s</ul>" % stale if stale else '<p class="empty">none</p>',
               "<ul>%s</ul>" % wts if wts else '<p class="empty">none</p>'))


def week_section(week, weeks, review, prev_review, hidden):
    start = week["start"][:10]
    end = (dt.datetime.fromisoformat(week["end"]) - dt.timedelta(seconds=1)).date().isoformat()
    return """
<section class="week" id="%s" %s>
<header><h1>Workflow retro · %s</h1><span class="muted">%s → %s · generated %s</span></header>
<h2>Experiments</h2>%s
<h2>Signals</h2>%s
<h2>Activity</h2>%s
<h2>Findings</h2>%s
<h2>Friction</h2>%s
<h2>Evidence</h2>%s
<h2>Breakdown</h2><div class="cols">%s%s%s</div>
%s
</section>""" % (
        esc(week["week"]), hidden, esc(week["week"]), esc(start), esc(end), esc(week["generated"][:16].replace("T", " ")),
        review_html(review, prev_review), tiles(SIGNALS, week, weeks), tiles(ACTIVITY, week, weeks),
        findings_html(review), friction_html(week), evidence_html(week),
        bars("Slash commands", week.get("commands")), bars("Tool errors by tool", week.get("tool_errors")),
        bars("Prompts by project", week.get("projects")), flow_html(week))


def cmd_render(args):
    files = sorted(p for p in WEEKS.glob("*.json") if not p.name.endswith(".review.json"))
    if not files:
        sys.exit("no weeks in %s — run `retro stats` first" % WEEKS)
    weeks = [json.loads(p.read_text()) for p in files]
    reviews = {}
    for p in WEEKS.glob("*.review.json"):
        reviews[p.name.split(".")[0]] = json.loads(p.read_text())
    current = args.week or weeks[-1]["week"]
    sections, options = [], []
    for i, week in enumerate(weeks):
        prev_review = reviews.get(weeks[i - 1]["week"]) if i else None
        hidden = "" if week["week"] == current else "hidden"
        sections.append(week_section(week, weeks[: i + 1], reviews.get(week["week"]), prev_review, hidden))
        options.append('<option value="%s"%s>%s</option>'
                       % (esc(week["week"]), " selected" if week["week"] == current else "", esc(week["week"])))
    page = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Workflow Retro</title>
<style>@@CSS@@</style></head><body><main>
<div style="display:flex;justify-content:flex-end;gap:8px"><label class="muted" for="wk">Week</label>
<select id="wk">@@OPTIONS@@</select></div>
@@SECTIONS@@
</main><script>
document.getElementById('wk').addEventListener('change', e => {
  document.querySelectorAll('section.week').forEach(s => s.hidden = s.id !== e.target.value);
});
</script></body></html>"""
    page = page.replace("@@CSS@@", CSS).replace("@@OPTIONS@@", "".join(reversed(options)))
    page = page.replace("@@SECTIONS@@", "".join(sections))
    out = RETRO / "dashboard.html"
    out.write_text(page)
    print(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("friction", help="capture one friction note")
    p.add_argument("text", nargs="+")
    p.set_defaults(func=cmd_friction)
    p = sub.add_parser("stats", help="measure a window and write its week file")
    p.add_argument("--days", type=int, default=7)
    p.add_argument("--end", help="last day of the window, YYYY-MM-DD (default: now)")
    p.set_defaults(func=cmd_stats)
    p = sub.add_parser("render", help="write the dashboard")
    p.add_argument("--week", help="week shown first, e.g. 2026-W40 (default: latest)")
    p.set_defaults(func=cmd_render)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
