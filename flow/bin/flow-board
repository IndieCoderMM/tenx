#!/usr/bin/env python3
"""Print every live flow work session: status, stage, phase progress, Resume line.

Usage: flow-board
"""

import json
import pathlib
import re
import subprocess

KINDS = ("build-", "review-", "proto-")


def aoe(*args):
    out = subprocess.run(["aoe", *args], capture_output=True, text=True)
    return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else None


def plan_for(session_path, slug):
    out = subprocess.run(
        ["git", "-C", session_path, "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True,
    )
    repo = pathlib.Path(out.stdout.strip()).parent.name if out.returncode == 0 else ""
    path = pathlib.Path.home() / ".tenx" / "flow" / repo / slug / "plan.md"
    return path.read_text() if repo and path.exists() else ""


def summary(text):
    stage = re.search(r"^stage:\s*(.+)$", text, re.M)
    phases = text.split("## Phases", 1)[-1].split("\n## ", 1)[0] if "## Phases" in text else ""
    done = len(re.findall(r"^- \[x\]", phases, re.M | re.I))
    total = done + len(re.findall(r"^- \[ \]", phases, re.M))
    resume = text.split("## Resume", 1)[-1].strip().splitlines() if "## Resume" in text else []
    return (
        stage.group(1).split()[0] if stage else "-",
        f"{done}/{total}" if total else "-",
        resume[0][:70] if resume else "-",
    )


rows = []
for s in aoe("list", "--json", "--state=live") or []:
    title = s.get("title", "")
    if not title.startswith(KINDS):
        continue
    slug = title.split("-", 1)[1]
    show = aoe("session", "show", s["id"], "--json") or {}
    rows.append((title, show.get("status", "?"), *summary(plan_for(s.get("path", ""), slug))))

if not rows:
    print("no flow sessions")
else:
    head = ("SESSION", "STATUS", "STAGE", "TASKS", "RESUME")
    widths = [max(len(str(r[i])) for r in [head, *rows]) for i in range(4)]
    for r in [head, *rows]:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)) + "  " + r[4])
