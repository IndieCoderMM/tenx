#!/usr/bin/env bash
# Start a flow work session in aoe and send it its first command.
#
#   flow-spawn build  <slug> [--model M]
#   flow-spawn review <slug>
#   flow-spawn proto  <slug> route|file "<question>"
#
# Run from the repo's main checkout. Exit 3: the session never became ready.
set -euo pipefail

die() { echo "flow-spawn: $*" >&2; exit "${2:-1}"; }
field() { python3 -I -c "import json,sys;print(json.load(sys.stdin).get('$1',''))"; }

kind="${1:-}"; slug="${2:-}"
[ -n "$kind" ] && [ -n "$slug" ] || die "usage: flow-spawn build|review|proto <slug> ..."
shift 2

main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")" \
  || die "not inside a git repo"
repo="$(basename "$main")"
dir="$HOME/.tenx/flow/$repo/$slug"
mkdir -p "$dir"

args=(-g "$repo" -l)
parent="$(aoe session current -q 2>/dev/null || true)"
[ -n "$parent" ] && args+=(-P "$parent")
claude_args="--permission-mode auto"

case "$kind" in
  build)
    [ -f "$dir/plan.md" ] || die "no plan.md at $dir — run /flow:shape first"
    if [ "${1:-}" = "--model" ]; then claude_args+=" --model ${2:?--model needs a value}"; fi
    title="build-$slug"; path="$main"; args+=(-w "$slug" -b)
    msg="/flow:build $slug"
    ;;
  review)
    path="$(aoe session show "build-$slug" --json 2>/dev/null | field path)"
    [ -n "$path" ] || die "no build-$slug session to review"
    title="review-$slug"
    msg="/flow:review $slug"
    ;;
  proto)
    mode="${1:-}"; question="${2:-}"
    [ -n "$question" ] || die "usage: flow-spawn proto <slug> route|file \"<question>\""
    mkdir -p "$dir/proto"
    printf '%s\n' "$question" > "$dir/proto/question.md"
    title="proto-$slug"; path="$main"
    case "$mode" in
      route) args+=(-w "$slug-proto" -b) ;;
      file)  claude_args+=" --add-dir $dir" ;;
      *) die "proto mode must be route or file" ;;
    esac
    msg="/flow:proto $slug $mode"
    ;;
  *) die "kind must be build, review, or proto" ;;
esac

aoe session show "$title" --json >/dev/null 2>&1 && die "session $title already exists"

aoe add "$path" -t "$title" "${args[@]}" --extra-args "$claude_args" >/dev/null

# Ready = Claude's input prompt is on screen. A worktree's on_create hook may
# install dependencies first, so allow a few minutes.
ready=""
for _ in $(seq 1 100); do
  pane="$(aoe session capture "$title" -n 40 --strip-ansi 2>/dev/null || true)"
  if grep -q "trust this folder" <<<"$pane"; then
    die "$title is waiting on a folder-trust dialog — attach and accept: aoe session attach $title" 3
  fi
  if grep -qE '^❯' <<<"$pane"; then ready=1; break; fi
  sleep 3
done
[ -n "$ready" ] || die "$title did not become ready — attach and check: aoe session attach $title" 3

aoe send "$title" "$msg" >/dev/null

wt="$(aoe session show "$title" --json | field path)"
if [ "$kind" = build ] && [ -f "$dir/plan.md" ]; then
  python3 -I - "$dir/plan.md" "$wt" <<'EOF'
import pathlib, re, sys
p = pathlib.Path(sys.argv[1])
p.write_text(re.sub(r"^worktree:.*$", f"worktree: {sys.argv[2]}", p.read_text(), count=1, flags=re.M))
EOF
fi

echo "started  $title"
echo "path     $wt"
echo "attach   aoe session attach $title"
